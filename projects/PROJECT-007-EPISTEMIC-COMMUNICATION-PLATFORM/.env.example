# Epistemic Communication Platform
# Copy this to .env and fill in your API keys

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/epistemic_platform

# CORS — comma-separated origins allowed to access the API
# For Railway: https://your-app.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
SECRET_KEY=change-this-in-production-minimum-32-characters-long

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_SONNET_MODEL=claude-sonnet-4-20250514
CLAUDE_OPUS_MODEL=claude-opus-4-20250514

# OpenAI (Whisper STT)
OPENAI_API_KEY=sk-...

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=...
ELEVENLABS_DEFAULT_VOICE_ID=...
