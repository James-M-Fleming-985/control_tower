# Control Tower .gitignore

# Cloned repositories (separate git repos)
cloned_repos/

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
env/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Data files (temporary)
*.csv
*.json
development_tracking.json
!projects/**/*.json
!m0v_baselines.json
!build_metrics_history.json

# Environment files
.env

# Python build artifacts
*.egg-info/

# Reports (generated)
todos/

# Logs
*.log
*.tar.gz
*.backup
backups/

# Temporary files that should not be in root
/temp_*.py
/tmp_*.py
/test_*.py
/debug_*.py
/quick_*.py
/scratch_*.py
/*_temp.md
/*_draft.md
/*_backup.*
*.bak.*
