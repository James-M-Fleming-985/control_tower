# Stripe Configuration
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Get your Price ID from https://dashboard.stripe.com/test/products
# Create a product "Feedback360 Pro" with recurring monthly billing at £9.99
PRICE_ID_PRO=price_your_price_id_here

# Frontend URLs (update with your production domain)
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/pricing

# Optional: Database (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/feedback360
