# 🎯 MAKEFILE TEMPLATE FOR REQUIREMENTS-DRIVEN DEVELOPMENT

# This template shows how to integrate requirements validation into your build process
# Adapt this for each level (Level 0-6) of your requirements hierarchy

# ==============================================================================
# CONFIGURATION
# ==============================================================================

# Project Configuration
PROJECT_NAME := {project_name}
REQUIREMENT_LEVEL := {0-6}
REQUIREMENT_ID := {REQ-ID}

# Directory Structure
REQUIREMENTS_DIR := requirements/level_$(REQUIREMENT_LEVEL)_*/
TESTS_DIR := testing/level_$(REQUIREMENT_LEVEL)_tests/
METRICS_DIR := metrics/collectors/
DOCS_DIR := docs/
TEMPLATES_DIR := templates/

# Tools and Commands
PYTHON := python3
PIP := pip3
PYTEST := pytest
FLAKE8 := flake8
BLACK := black
COVERAGE := coverage

# ==============================================================================
# HELP SYSTEM
# ==============================================================================

.PHONY: help
help: ## Show this help message
	@echo "🎯 Requirements-Driven Development Makefile"
	@echo "Level $(REQUIREMENT_LEVEL): $(PROJECT_NAME)"
	@echo ""
	@echo "Available targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

# ==============================================================================
# REQUIREMENTS MANAGEMENT
# ==============================================================================

.PHONY: req-validate
req-validate: ## Validate all requirements at this level
	@echo "🔍 Validating Level $(REQUIREMENT_LEVEL) requirements..."
	@$(PYTHON) tools/requirement_tools/req_validator.py --level $(REQUIREMENT_LEVEL)

.PHONY: req-trace
req-trace: ## Check requirements traceability
	@echo "🔗 Checking requirements traceability..."
	@$(PYTHON) tools/requirement_tools/req_tracer.py --requirement $(REQUIREMENT_ID)

.PHONY: req-coverage
req-coverage: ## Generate requirements coverage report
	@echo "📊 Generating requirements coverage report..."
	@$(PYTHON) tools/requirement_tools/req_analyzer.py --coverage --level $(REQUIREMENT_LEVEL)

.PHONY: req-impact
req-impact: ## Analyze impact of requirement changes
	@echo "🎯 Analyzing requirement change impact..."
	@$(PYTHON) tools/requirement_tools/req_analyzer.py --impact --requirement $(REQUIREMENT_ID)

# ==============================================================================
# TESTING FRAMEWORK
# ==============================================================================

.PHONY: test
test: test-requirements test-functional test-integration ## Run all tests

.PHONY: test-requirements
test-requirements: ## Test requirements validation
	@echo "✅ Testing requirements validation..."
	@$(PYTEST) $(TESTS_DIR)/requirements/ -v --tb=short

.PHONY: test-functional
test-functional: ## Run functional tests against requirements
	@echo "⚙️ Running functional tests..."
	@$(PYTEST) $(TESTS_DIR)/functional/ -v --tb=short

.PHONY: test-integration
test-integration: ## Run integration tests
	@echo "🔗 Running integration tests..."
	@$(PYTEST) $(TESTS_DIR)/integration/ -v --tb=short

.PHONY: test-coverage
test-coverage: ## Generate test coverage report
	@echo "📊 Generating test coverage report..."
	@$(COVERAGE) run -m pytest $(TESTS_DIR)
	@$(COVERAGE) report -m
	@$(COVERAGE) html

# ==============================================================================
# METRICS COLLECTION
# ==============================================================================

.PHONY: metrics-collect
metrics-collect: ## Collect metrics for this level
	@echo "📊 Collecting Level $(REQUIREMENT_LEVEL) metrics..."
	@$(PYTHON) $(METRICS_DIR)/level_$(REQUIREMENT_LEVEL)_collector.py

.PHONY: metrics-rollup
metrics-rollup: ## Roll up metrics to next level
	@echo "⬆️ Rolling up metrics to Level $$(( $(REQUIREMENT_LEVEL) - 1 ))..."
	@$(PYTHON) metrics/rollup/level_$(REQUIREMENT_LEVEL)_to_$$(( $(REQUIREMENT_LEVEL) - 1 ))_rollup.py

.PHONY: metrics-dashboard
metrics-dashboard: ## Generate metrics dashboard
	@echo "📈 Generating metrics dashboard..."
	@$(PYTHON) metrics/dashboards/level_$(REQUIREMENT_LEVEL)_dashboard.py

.PHONY: metrics-analysis
metrics-analysis: ## Analyze metrics trends
	@echo "🔍 Analyzing metrics trends..."
	@$(PYTHON) metrics/analysis/trend_analysis.py --level $(REQUIREMENT_LEVEL)

# ==============================================================================
# QUALITY GATES
# ==============================================================================

.PHONY: quality-gate
quality-gate: quality-requirements quality-code quality-tests quality-metrics ## Run all quality gates

.PHONY: quality-requirements
quality-requirements: ## Validate requirements quality
	@echo "🎯 Checking requirements quality..."
	@$(PYTHON) workflows/quality_gates/requirement_gate.py --level $(REQUIREMENT_LEVEL)

.PHONY: quality-code
quality-code: ## Check code quality
	@echo "💻 Checking code quality..."
	@$(FLAKE8) . --count --select=E9,F63,F7,F82 --show-source --statistics
	@$(BLACK) --check .

.PHONY: quality-tests
quality-tests: ## Validate test quality
	@echo "✅ Checking test quality..."
	@$(PYTHON) workflows/quality_gates/testing_gate.py --level $(REQUIREMENT_LEVEL)

.PHONY: quality-metrics
quality-metrics: ## Validate metrics quality
	@echo "📊 Checking metrics quality..."
	@$(PYTHON) workflows/quality_gates/metrics_gate.py --level $(REQUIREMENT_LEVEL)

# ==============================================================================
# DOCUMENTATION
# ==============================================================================

.PHONY: docs-generate
docs-generate: ## Generate documentation from requirements
	@echo "📚 Generating documentation..."
	@$(PYTHON) tools/doc_generator.py --level $(REQUIREMENT_LEVEL)

.PHONY: docs-validate
docs-validate: ## Validate documentation completeness
	@echo "📋 Validating documentation..."
	@$(PYTHON) tools/doc_validator.py --level $(REQUIREMENT_LEVEL)

.PHONY: docs-traceability
docs-traceability: ## Generate traceability matrix
	@echo "🔗 Generating traceability matrix..."
	@$(PYTHON) traceability/mapping/requirement_mapper.py --level $(REQUIREMENT_LEVEL)

# ==============================================================================
# WORKFLOW AUTOMATION
# ==============================================================================

.PHONY: workflow-validate
workflow-validate: ## Validate workflow configuration
	@echo "🔄 Validating workflow configuration..."
	@$(PYTHON) workflows/requirements_driven/requirement_validation.py

.PHONY: workflow-execute
workflow-execute: ## Execute requirements-driven workflow
	@echo "⚡ Executing workflow..."
	@$(PYTHON) workflows/requirements_driven/workflow_executor.py --level $(REQUIREMENT_LEVEL)

.PHONY: workflow-monitor
workflow-monitor: ## Monitor workflow execution
	@echo "👁️ Monitoring workflow..."
	@$(PYTHON) workflows/automation/health_checker.py --level $(REQUIREMENT_LEVEL)

# ==============================================================================
# CONTINUOUS INTEGRATION
# ==============================================================================

.PHONY: ci-setup
ci-setup: ## Setup CI environment
	@echo "🚀 Setting up CI environment..."
	@$(PIP) install -r requirements.txt
	@$(PIP) install -r requirements-dev.txt

.PHONY: ci-validate
ci-validate: req-validate quality-gate test metrics-collect ## Full CI validation pipeline

.PHONY: ci-deploy
ci-deploy: ci-validate ## Deploy after validation
	@echo "🚀 Deploying Level $(REQUIREMENT_LEVEL) components..."
	@$(PYTHON) workflows/automation/deployment_manager.py --level $(REQUIREMENT_LEVEL)

# ==============================================================================
# MAINTENANCE
# ==============================================================================

.PHONY: clean
clean: ## Clean generated files
	@echo "🧹 Cleaning generated files..."
	@find . -type f -name "*.pyc" -delete
	@find . -type d -name "__pycache__" -delete
	@rm -rf .pytest_cache/
	@rm -rf htmlcov/
	@rm -rf .coverage

.PHONY: reset
reset: clean ## Reset to clean state
	@echo "🔄 Resetting to clean state..."
	@rm -rf metrics/storage/daily_metrics/$(date +%Y%m%d)*
	@rm -rf testing/reports/*
	@rm -rf docs/generated/*

.PHONY: backup
backup: ## Backup current state
	@echo "💾 Creating backup..."
	@tar -czf backup_$(shell date +%Y%m%d_%H%M%S).tar.gz \
		requirements/ metrics/ testing/ docs/ \
		--exclude="*.pyc" --exclude="__pycache__"

# ==============================================================================
# DEVELOPMENT WORKFLOWS
# ==============================================================================

.PHONY: dev-setup
dev-setup: ## Setup development environment
	@echo "🛠️ Setting up development environment..."
	@$(PIP) install -r requirements-dev.txt
	@pre-commit install

.PHONY: dev-validate
dev-validate: req-validate test-requirements quality-code ## Quick development validation

.PHONY: dev-deploy
dev-deploy: dev-validate metrics-collect ## Development deployment

# ==============================================================================
# INTEGRATION WITH CONTROL TOWER
# ==============================================================================

.PHONY: tower-sync
tower-sync: ## Sync with Control Tower
	@echo "🗼 Syncing with Control Tower..."
	@$(PYTHON) control_tower.py --sync --level $(REQUIREMENT_LEVEL)

.PHONY: tower-report
tower-report: ## Generate Control Tower report
	@echo "📊 Generating Control Tower report..."
	@$(PYTHON) control_tower.py --report --level $(REQUIREMENT_LEVEL)

.PHONY: tower-dashboard
tower-dashboard: ## Update Control Tower dashboard
	@echo "📈 Updating Control Tower dashboard..."
	@$(PYTHON) control_tower.py --dashboard --level $(REQUIREMENT_LEVEL)

# ==============================================================================
# LEVEL-SPECIFIC TARGETS (Override in level-specific makefiles)
# ==============================================================================

.PHONY: level-specific
level-specific: ## Level-specific operations
	@echo "🎯 Executing Level $(REQUIREMENT_LEVEL) specific operations..."
	# Override this target in level-specific makefiles

# ==============================================================================
# DEFAULT TARGET
# ==============================================================================

.DEFAULT_GOAL := help

# ==============================================================================
# EXAMPLE USAGE TARGETS
# ==============================================================================

.PHONY: example-daily
example-daily: req-validate test-requirements metrics-collect ## Example daily workflow

.PHONY: example-weekly
example-weekly: ci-validate metrics-rollup docs-generate tower-report ## Example weekly workflow

.PHONY: example-monthly
example-monthly: req-coverage quality-gate metrics-analysis docs-traceability ## Example monthly workflow

# ==============================================================================
# AUTOMATION SCHEDULING
# ==============================================================================

.PHONY: schedule-daily
schedule-daily: ## Schedule daily automation
	@echo "⏰ Scheduling daily automation..."
	@$(PYTHON) workflows/automation/daily_sync.py --schedule --level $(REQUIREMENT_LEVEL)

.PHONY: schedule-weekly  
schedule-weekly: ## Schedule weekly automation
	@echo "📅 Scheduling weekly automation..."
	@$(PYTHON) workflows/automation/weekly_rollup.py --schedule --level $(REQUIREMENT_LEVEL)

.PHONY: schedule-monthly
schedule-monthly: ## Schedule monthly automation
	@echo "📆 Scheduling monthly automation..."
	@$(PYTHON) workflows/automation/monthly_analysis.py --schedule --level $(REQUIREMENT_LEVEL)

# ==============================================================================
